# Laravel Forge API token — https://forge.laravel.com/profile/api
FORGE_API_KEY=

# Optional: pin a default organization slug, so tools do not take it as an argument.
# When unset, every tool exposes and requires an `organization` argument instead.
FORGE_ORGANIZATION=

# Optional: register destructive tools (server/site/database deletion, arbitrary
# command and custom-recipe execution, org & team mutation).
# Even when enabled, every destructive tool still requires a matching `confirm` argument.
FORGE_MCP_ALLOW_DESTRUCTIVE=

# Optional: the scopes your token was created with, comma or space separated.
# When set, only tools those scopes can use are registered, so a missing scope shows
# up as an absent tool rather than a 403 mid-task. Run `--scopes` to print every
# valid scope and some ready-made profiles. Leave blank to register everything.
FORGE_SCOPES=

# Optional: override the API base URL (useful for testing against a mock server).
FORGE_API_BASE_URL=

# Optional: per-request HTTP timeout, in milliseconds. Default 30000.
FORGE_TIMEOUT_MS=

# Optional: retry attempts for 429 and 5xx responses. Default 3.
FORGE_MAX_RETRIES=

# Optional: override the polling budget used by `wait: true`, in milliseconds.
# Each operation carries its own default — 30 minutes for server provisioning,
# 2 minutes for everything else — so these are for slow providers, not routine use.
FORGE_POLL_TIMEOUT_MS=
FORGE_POLL_INTERVAL_MS=
