# Laravel Forge API token — https://forge.laravel.com/profile/api
FORGE_API_KEY=

# Optional: pin a default organization slug so tools don't need it passed each call.
# When unset, the server resolves the first organization the token can see at startup.
FORGE_ORGANIZATION=

# Optional: register destructive tools (server/site/database deletion, org & team mutation).
# Even when enabled, every destructive tool still requires a matching `confirm` argument.
FORGE_MCP_ALLOW_DESTRUCTIVE=

# Optional: override the API base URL (useful for testing against a mock server).
FORGE_API_BASE_URL=
